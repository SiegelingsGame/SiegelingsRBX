makeEvent("EvolveResult")    -- server → client (success, newCreatureId or errorMessage)
makeEvent("CombineCreatures") -- client sends {uid1, uid2, uid3}
makeEvent("CombineResult")   -- server → client (success, newUid or errorMessage)
