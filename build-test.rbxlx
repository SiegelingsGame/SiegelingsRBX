	},
	{
		category = "pvp_koth",
		initiatorId = "mystic",
		responderId = "salty_vet",
		messages = {
			"The Hill will have a new master by week's end. Or the same. The wind is unclear.",
			"Helpful. So either someone wins or they don't.",
			"Yes.",
			"Yeah. I'll stick to the ticker. Less cryptic.",
