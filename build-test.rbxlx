		icon = "egg_purple",
		desc = "Rare or Mythic",
		coinCost = 25000,
		gemCost = 1750,
		robuxCost = 199,
		productId = 0,
		pool = {
			{ rarity = "Rare",   weight = GameConfig.EggMythic_RarePct   },
			{ rarity = "Mythic", weight = GameConfig.EggMythic_MythicPct },
		},
	},
	{
		id = "egg_legendary",
		name = "Legendary Egg",
		icon = "egg_gold",
		desc = "Rare, Mythic, or Legendary",
		coinCost = 50000,
		gemCost = 3400,
		robuxCost = 499,
