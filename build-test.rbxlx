dungeonTitle.TextColor3 = Color3.fromRGB(255, 184, 0)
dungeonTitle.Font = Enum.Font.GothamBlack
dungeonTitle.TextSize = 14
dungeonTitle.TextXAlignment = Enum.TextXAlignment.Left
